# ── Источники данных ──────────────────────────────────────────────
# Рекомендуется всё читать из BigQuery (данные обновляются ночью, ручные выгрузки не нужны):
#   HOPTED_SOURCE=bq  REFERENCE_SOURCE=bq  SOURCES_SOURCE=bq  INCOMING_SOURCE=bq
#   SHIPMENTS_SOURCE=sheet:128q44-RfvoJSLOHMHT-RaYwJMMJKleCvuQxI9uLgGfk   (Logistics Dashboard, вкладка calc_shipments)
# Любой источник можно заменить CSV-файлом. Hopted, лист "US V2": CSV (File → Download → CSV), sheet:<ID> или bq
HOPTED_SOURCE=bq
SOURCES_SOURCE=bq
INCOMING_SOURCE=bq
SHIPMENTS_SOURCE=sheet:128q44-RfvoJSLOHMHT-RaYwJMMJKleCvuQxI9uLgGfk
# Приходы планировщика приходят по месяцам и сразу по всем направлениям, оценка оптимистична: по умолчанию выключены
USE_PLANNER_INCOMING=false
HOPTED_TAB=US V2
HOPTED_RANGE=A:T
# json сервисного аккаунта (нужен для листов Google вне Cloud Shell/Cloud Run); без него берутся учётные данные окружения
GOOGLE_CREDENTIALS_FILE=

# Справочник (группа/цвет/размер/active_us): CSV (см. export_reference.sh) или bq (читать из BigQuery напрямую)
REFERENCE_SOURCE=bq
BQ_PROJECT=reorder-497714

# Необязательно: партии с точными датами (asin, qty, eta, destination; берутся только AMZ)
BATCHES_CSV=

# ── Допущения. LEAD_SEA взят по фактическим отправкам US (медиана ETD → доставка ≈ 30 дн.); LEAD_AIR — допущение, воздухом не возили ──
LEAD_AWD=7
LEAD_WAREHOUSE=14
# LEAD_SEA не задавайте: срок моря берётся из фактических отправок (если задать — будет использовано заданное)
LEAD_AIR=10
RECEIVING_DAYS=3
SHIPPED_DAYS=14
INCLUDE_WORKING=false
TARGET_COVER_DAYS=45
WEIGHT_7D=0.5
BATCH_DELAY_DAYS=14
# off = только факт продаж; fallback = для ASIN без продаж брать план (шумно, ловит и неактивные); floor = не ниже плана
PLAN_MODE=off

# ── Алерт в Telegram ───────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DASHBOARD_URL=
ALERT_MIN_LOST_30=5
